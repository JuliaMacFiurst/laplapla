    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "sharp": "0.35.3",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.5"
