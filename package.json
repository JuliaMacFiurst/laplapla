    "gif.js": "^0.2.0",
    "idb": "^8.0.3",
    "next": "^16.2.12",
    "openai": "^5.5.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sanitize-html": "2.17.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.4",
